# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/
.DS_Store
*.log
.venv/
venv/
.qoder/
midscene_run/

# 真实配置文件含密钥，不入库（请从 evalapp.yaml.example 复制生成）
evalapp.yaml
# DingTalk 机器人配置（如有，含 access_token / secret）
**/dingtalk.yaml

# Results (历史归档数据) - 仅匹配仓库根目录，避免误伤源码包 evalapp/results/
/results/

# Eval workspace 运行产物（仅匹配仓库根目录，整个 workspaces/ 均为运行时生成，不提交）
/workspaces/

# Generated projects in eval workspace (large files, not needed in git)
generated_projects/

# 产物直评默认输出目录（evalapp evaluate --url/--apk/--app/--project，可用 --output 改）
eval_output/

# AI UI Test内置工具(npm install自动生成)
tools/ai-ui-test/node_modules/
tools/ai-ui-test/dist/
tools/ai-ui-test/.test_intermediates/
tools/ai-ui-test/midscene_run/
tools/ai-ui-test/cache/

# Deployment files (auto-generated)
*.pid
/pids/
/logs/
logs/*.log

# Workspace test directories (runtime generated)
workspace_color_test/

# Symbolic links (deprecated)
show-address

# Temporary review artifacts (generated by review process)
.review_diff.tmp

# 控制台（后端核心 + 前端 + 部署脚本）已迁至独立仓库，
# 本仓只保留评测能力，不再有 studio/ 与 deploy/ 目录
